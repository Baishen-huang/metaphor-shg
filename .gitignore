data/

# ---- 内部工作记录（不入库）----
.workbuddy/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
venv_jieba/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

