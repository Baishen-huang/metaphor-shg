experiments/**/_tmp/
experiments/**/*.log.tmp

# ---- 并行实验的 worktree（各自是独立检出，不嵌套入库）----
.wt/

# ---- gen3 重放缓存（二进制、可复算：cache_default ~5s / cache_real ~60s）----
